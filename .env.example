# Generate a 32+ byte secret, then Base64 encode it: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
MONGODB_URI=mongodb://localhost:27017/securecare
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5500
JWT_EXPIRATION_MS=900000
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD
APP_ADMIN_EMAIL=admin@example.test
